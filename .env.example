# Firebase web config (public by design). Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# App Check → reCAPTCHA Enterprise site key (production builds).
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Optional: a registered App Check debug token for local development (never commit a real one).
VITE_APPCHECK_DEBUG_TOKEN=
